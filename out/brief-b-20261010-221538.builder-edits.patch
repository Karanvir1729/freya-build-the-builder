+def note_text_carries_the_customers_reason():               # Brief F PUB-05: the note must name the job loss
+    P, V = start([CARD, LOAN], multi=True, notes=True)
+    ev(P, V, "hardship", topic="hardship", customer_said="I lost my job last month")
