   }
  ],
  "outcomes": [
   {
    "outcome": "not_reached",
    "reason": "unclear",
    "when": "still unclear who is on the line after the second ask; rule 3"
   },
   {
    "outcome": "not_reached",
    "reason": "callback",
    "when": "callback scheduled; rule 6"
   },
   {
    "outcome": "not_reached",
    "reason": "no_callback",
    "when": "second offered callback time also outside window; rule 7"
   },
   {
    "outcome": "not_reached",
    "reason": "wrong_number",
    "when": "number does not belong to the customer; rule 8"
   },
   {
    "outcome": "not_reached",
    "reason": "deceased",
    "when": "person says the customer has died; rule 9"
   },
   {
    "outcome": "not_verified",
    "reason": "failed",
    "when": "three wrong answers; rule 14"
   },
   {
    "outcome": "not_verified",
    "reason": "declined",
    "when": "second refusal or second 'what is this about' instead of answering; unverified customer says twice they do not want to talk; rule 15"
   },
   {
    "outcome": "no_promise",
    "reason": "refused",
    "when": "persuasion attempts used up; verified customer says twice they do not want to talk; rules 31 and 45"
   },
   {
    "outcome": "transferred",
    "reason": "support",
    "when": "hardship customer accepts support transfer; rule 32"
   },
   {
    "outcome": "no_promise",
    "reason": "hardship",
    "when": "hardship customer declines transfer; rule 32"
   },
   {
    "outcome": "no_promise",
    "reason": "service_error",
    "when": "create_promise failed twice; rule 37"
   },
   {
    "outcome": "paid",
    "reason": "",
    "when": "customer says they already paid this past-due amount; rule 39"
   },
   {
    "outcome": "no_promise",
    "reason": "dispute",
    "when": "customer disputes the debt or product; rule 40"
   },
   {
    "outcome": "transferred",
    "reason": "restructuring",
    "when": "customer asks for a payment plan or lower instalments; rule 41"
   },
   {
    "outcome": "transferred",
    "reason": "human",
    "when": "customer insists on a human after being asked once; rule 42"
   },
   {
    "outcome": "promise",
    "reason": "",
    "when": "at least one promise was recorded"
   }
  ],
  "verbatim": [
   {
    "text": "Am I speaking with {title} {last_name}?",
    "when": "R07: Ask \"Am I speaking with {title} {last_name}?\"."
   },
   {
    "text": "I am sorry for your loss.",
    "when": "R15: If the person says the customer has died, say \"I am sorry for your loss.\", ask nothing else, close `not_reached` / `deceased`."
   },
   {
    "text": "Can you make this payment today?",
    "when": "R37: First ask: \"Can you make this payment today?\"."
   },
   {
    "text": "Do you confirm?",
    "when": "R43: Read the product, amount and date back and ask \"Do you confirm?\". Call `create_promise` only after a clear yes."
   },
   {
    "text": "You will receive a text message confirming this promise.",
    "when": "R47: After a recorded promise, say: \"You will receive a text message confirming this promise.\""
   }
  ],
  "forbidden_words_before_verification": [
